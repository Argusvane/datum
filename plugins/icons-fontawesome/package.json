{
  "name": "@argusvane/datum-icons-fontawesome",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Argusvane <maintainers@argusvane.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argusvane/datum.git",
    "directory": "plugins/icons-fontawesome"
  },
  "homepage": "https://datum.argusvane.com",
  "bugs": {
    "url": "https://github.com/argusvane/datum/issues"
  },
  "keywords": [
    "datum",
    "forms",
    "icons",
    "plugin"
  ],
  "description": "Font Awesome Free (solid) as an icon set for the Datum builder and renderer chrome.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "datumPlugin": {
    "id": "icons-fontawesome",
    "bundle": "datum-icons-fontawesome",
    "global": "DatumIconsFontAwesome",
    "sentinel": "font-awesome",
    "budgetKb": 44
  },
  "scripts": {
    "build": "node ./node_modules/@argusvane/datum/scripts/plugin-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@argusvane/datum-engine": "file:../../engine",
    "@fortawesome/free-solid-svg-icons": "^7.3.1"
  },
  "devDependencies": {
    "@argusvane/datum": "file:../../packages/datum",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
