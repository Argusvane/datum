<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-examples</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>datum-example-webflux-pdf</artifactId>
  <packaging>jar</packaging>
  <name>datum-example-webflux-pdf</name>
  <description>A Spring WebFlux application with the PDF starter: the server prints, fills, seals and verifies PDFs of a form's answers.</description>

  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-boot-starter-pdf</artifactId>
    </dependency>
    <!-- The renderer: datum-form.js and the glue, served from the versioned assets path, for the page that asks for the PDF. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-boot-starter-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- /actuator/health carries the datum runtime and pdf checks, /actuator/info the datum capabilities. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Who may build: Spring Security with Datum's request matchers (HTTP Basic, as ui-builder-jpa). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- JDBC, so the timestamp authority's serial numbers are rows of datum_tsa_log (V300 migration, applied at start to the
         in-memory database) and not the in-memory allocator a restart would forget. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The cross-capability test: the fake runtime and helpers, passkeys (not part of the example itself) and springdoc's
         documents (the example serves none; the test asks for them). The timestamp routes come with the PDF starter. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-boot-starter-webauthn</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
      <version>${springdoc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- The Panama runner (JDK 22+) calls restricted native methods; this lets java -jar do so without a warning. -->
          <archive>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
