<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-spring-boot-starter-submissions</artifactId>
  <packaging>jar</packaging>
  <name>datum-spring-boot-starter-submissions</name>
  <description>Starter: server-validate a form submission.</description>
  <properties>
    <!-- No tests here and no JUnit on the class path: surefire refuses a groups filter without a JUnit engine, so the root
         pom's default exclusion of the containers tag is switched off for a module that has none. -->
    <datum.test.excludedGroups></datum.test.excludedGroups>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-programs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-endive</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-endive-jffi</artifactId>
      <type>pom</type>
    </dependency>
    <!-- Both runners: the runtime picks Panama on Java 25+ and JFFI below it; exclude Panama below Java 25 and JFFI only on
         Java 25+ to slim the app (with no usable native runner the start is refused unless datum.runtime.allow-bytecode=true). -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-endive-panama</artifactId>
      <type>pom</type>
    </dependency>
    <!-- The sandbox binding: datum.runtime.* properties, the engine and sandbox beans, lifecycle, health and the datum endpoint. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-forms-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-submissions-spring</artifactId>
    </dependency>
    <!-- The starter brings no web stack: the application adds spring-boot-starter-webmvc or -webflux, and the endpoints
         (POST /api/submissions, /api/submissions/validate; test and inspect on request) are mapped on whichever it has. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
  </dependencies>
</project>
