<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-spring-boot-starter-timestamp</artifactId>
  <packaging>jar</packaging>
  <name>datum-spring-boot-starter-timestamp</name>
  <description>Starter: an RFC 3161 server and client.</description>
  <properties>
    <!-- No tests here and no JUnit on the class path: surefire refuses a groups filter without a JUnit engine, so the root
         pom's default exclusion of the containers tag is switched off for a module that has none. -->
    <datum.test.excludedGroups></datum.test.excludedGroups>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-timestamp-spring</artifactId>
    </dependency>
    <!-- The auto-configuration machinery; deliberately nothing of the sandbox runtime, which the timestamp server does not use. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
  </dependencies>
</project>
