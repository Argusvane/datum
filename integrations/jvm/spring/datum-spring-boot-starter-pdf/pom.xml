<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-spring-boot-starter-pdf</artifactId>
  <packaging>jar</packaging>
  <name>datum-spring-boot-starter-pdf</name>
  <description>Starter: server PDF render, fill, sign and verify.</description>
  <properties>
    <!-- No tests here and no JUnit on the class path: surefire refuses a groups filter without a JUnit engine, so the root
         pom's default exclusion of the containers tag is switched off for a module that has none. -->
    <datum.test.excludedGroups></datum.test.excludedGroups>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-pdf-spring</artifactId>
    </dependency>
    <!-- Seals can carry an RFC 3161 token: a timestamp server named by datum.pdf.signing.tsa.url, or the application's own
         authority (datum.tsa.enabled=true) when the timestamp module's endpoints are wanted too. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-timestamp-spring</artifactId>
    </dependency>
    <!-- PDFs are made by the PDF program on the sandbox runtime: datum-sandbox-spring provides it (the submissions starter brings
         it too, with datum-core, the programs, the Endive runtime with both runners, datum-forms(-spring), datum-spring-web and
         datum-submissions(-spring), which POST /pdf still needs for its receiver). -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-spring-boot-starter-submissions</artifactId>
    </dependency>
    <!-- A named timestamp server (datum.pdf.signing.tsa.url) is reached through the application's RestClient.Builder: its
         customisers, observation, the request factory's proxy and timeouts, and datum.pdf.signing.tsa.ssl-bundle. Without
         this starter the binding falls back to the JDK's HttpClient. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
  </dependencies>
</project>
