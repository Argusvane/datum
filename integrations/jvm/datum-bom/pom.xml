<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Standalone (no parent): datum-parent imports this BOM, so a parent link would be a cycle. -->
  <groupId>com.argusvane</groupId>
  <artifactId>datum-bom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>datum-bom</name>
  <description>Bill of materials for Datum on the JVM: every Datum library, Spring Boot binding and starter, the host test kit, plus the pinned third-party libraries.</description>
  <url>https://datum.argusvane.com</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>Argusvane</name>
    <url>https://argusvane.com</url>
  </organization>
  <developers>
    <developer>
      <id>argusvane</id>
      <name>Argusvane maintainers</name>
      <email>maintainers@argusvane.com</email>
      <organization>Argusvane</organization>
      <organizationUrl>https://argusvane.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/argusvane/datum</url>
    <connection>scm:git:https://github.com/argusvane/datum.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/argusvane/datum.git</developerConnection>
  </scm>

  <properties>
    <revision>0.1.0-SNAPSHOT</revision>
    <endive.version>1.2.0</endive.version>
    <jffi.version>1.4.7</jffi.version>
    <jimfs.version>1.3.2</jimfs.version>
    <caffeine.version>3.3.1</caffeine.version>
    <!-- The libraries do not inherit Spring Boot's BOM, so the nullability annotations are pinned here; 1.0.1 is the
         version Boot 4.2 manages, so an application sees one jar. -->
    <jspecify.version>1.0.1</jspecify.version>
    <bouncycastle.version>1.87</bouncycastle.version>
    <webauthn4j.version>0.32.0.RELEASE</webauthn4j.version>
    <jcs.version>1.1</jcs.version>
    <swagger.version>2.2.56</swagger.version>
    <springdoc.version>3.2.1</springdoc.version>
    <!-- keep in step with datum-parent -->
    <flatten-maven-plugin.version>1.9.0</flatten-maven-plugin.version>
    <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
  </properties>

