<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-submissions</artifactId>
  <packaging>jar</packaging>
  <name>datum-submissions</name>
  <description>Datum submissions: the receiver, handler SPIs, events, the runtime lifecycle and endpoints. Framework-free library; the Spring Boot binding is datum-submissions-spring.</description>
  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox</artifactId>
    </dependency>
    <!-- Nullability annotations on the public SPI packages: optional, like micrometer-observation. An absent
         annotation class is ignored at run time; an IDE, Kotlin or NullAway user adds org.jspecify:jspecify to read them. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The runtime API is datum-sandbox's GuestRuntime (sandbox.wasi); the Endive engine jar comes through the submissions
         starter. The auto-configuration names no engine class: it selects a GuestRuntimeProvider by id. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-programs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-web-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-forms</artifactId>
    </dependency>
    <!-- No JDBC here: the SQL stores and their database tests are the -spring binding's; the
         library ships only the SPIs, the in-memory stores and the migration scripts. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The sandbox's test helpers (the scripted TestRuntime, the stand-in programs); datum-sandbox-test-support is never
         published. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The shared test helpers (the library-boundary rule, the settings-record copy check, the recording observation registry);
         datum-core-test-support is never published. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The helpers this module's -spring binding shares with its own tests (fixtures, fake runtimes) live in
             datum-submissions-test-support, which depends on this module; a dependency back would be a cycle, so this module's tests
             compile the same sources and resources from there. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-helpers</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../datum-submissions-test-support/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-test-helper-resources</id>
            <phase>generate-test-resources</phase>
            <goals><goal>add-test-resource</goal></goals>
            <configuration>
              <resources>
                <resource><directory>${project.basedir}/../datum-submissions-test-support/src/main/resources</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
