<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-webauthn</artifactId>
  <packaging>jar</packaging>
  <name>datum-webauthn</name>
  <description>Datum WebAuthn: passkey registration ceremony and signed submissions. Framework-free library; the Spring Boot binding is datum-webauthn-spring.</description>
  <dependencies>
    <!-- Nullability annotations on the public SPI packages: optional, like micrometer-observation. An absent
         annotation class is ignored at run time; an IDE, Kotlin or NullAway user adds org.jspecify:jspecify to read them. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The library (root package and .submissions): CanonicalJson/Jcs and the signing contracts. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core</artifactId>
    </dependency>
    <!-- webauthn4j 0.32.0 on Jackson 3: the non-strict manager parses and verifies every ceremony (webauthn4j-first). -->
    <dependency>
      <groupId>com.webauthn4j</groupId>
      <artifactId>webauthn4j-core</artifactId>
    </dependency>
    <!-- The second implementation of RFC 8785 every JCS vector is held to (28/28). The signed text is datum-core's
         Jcs, whose number formatter matches ECMAScript's, so this library is test scope. -->
    <dependency>
      <groupId>io.github.erdtman</groupId>
      <artifactId>java-json-canonicalization</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The receiver's signature seam (SubmissionSignatureCheck): only when the application has submissions. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-submissions</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The passkey facade (package .web) answers through datum-web-core; the Spring adapters and auto-configuration live in
         datum-webauthn-spring. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-web-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared test helpers (the library-boundary rule, the settings-record copy check, the recording observation registry);
         datum-core-test-support is never published. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- The helpers this module's -spring binding shares with its own tests (fixtures, fake runtimes) live in
             datum-webauthn-test-support, which depends on this module; a dependency back would be a cycle, so this module's tests
             compile the same sources and resources from there. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-helpers</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../datum-webauthn-test-support/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-test-helper-resources</id>
            <phase>generate-test-resources</phase>
            <goals><goal>add-test-resource</goal></goals>
            <configuration>
              <resources>
                <resource><directory>${project.basedir}/../datum-webauthn-test-support/src/main/resources</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
