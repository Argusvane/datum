<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.argusvane</groupId>
    <artifactId>datum-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>datum-pdf</artifactId>
  <packaging>jar</packaging>
  <name>datum-pdf</name>
  <description>Datum PDF: server render, fill, sign and verify. Framework-free library; the Spring Boot binding is datum-pdf-spring.</description>
  <dependencies>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-forms</artifactId>
    </dependency>
    <!-- The PDF runs take the sandbox's PDF slots and program (datum-sandbox, above). What is left of this dependency is the api
         package: POST /pdf judges the answers with the submission receiver's dry run, applies its throttle and reads its host
         context before it renders them (PdfApi). -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-submissions</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-programs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-timestamp</artifactId>
    </dependency>
    <!-- TestSeal makes the throwaway certificate of a test PDF with Bouncy Castle (datum-timestamp brings
         it already; declared because datum-pdf uses it directly). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
    </dependency>
    <!-- The observation tests record on a real ObservationRegistry (datum-core's RecordingObservations);
         the library itself names no Micrometer type (DatumObservations is plain Java). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-observation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared test helpers (the library-boundary rule, the settings-record copy check, the recording observation registry);
         datum-core-test-support is never published. -->
    <dependency>
      <groupId>com.argusvane</groupId>
      <artifactId>datum-core-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>${basedir}/src/main/resources</directory></resource>
      <!-- The generated assets (target/datum-assets/<artifactId>) land under META-INF/datum/ (programs/, assets/, manifest.json); NOTICE (and LICENSE) reach META-INF/ through the parent pom's copy-legal execution. -->
      <resource>
        <directory>${datum.assets.dir}/${project.artifactId}</directory>
        <targetPath>META-INF/datum</targetPath>
        <excludes><exclude>NOTICE</exclude><exclude>test-fixtures/**</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- The helpers this module's -spring binding shares with its own tests (fixtures, fake runtimes) live in
             datum-pdf-test-support, which depends on this module; a dependency back would be a cycle, so this module's tests
             compile the same sources and resources from there. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-test-helpers</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../datum-pdf-test-support/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- The generated assets are build output (target/datum-assets, written by the root build); a -pl build with none must say how to make them. Checked at process-resources, where they are used, so a build that stops earlier (the CI runtime compile, up to generate-sources) needs none. -->
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-assets</id>
            <phase>process-resources</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files><file>${datum.assets.dir}/${project.artifactId}/manifest.json</file></files>
                  <message>the generated assets are missing (${datum.assets.dir}/${project.artifactId}): run ./mvnw -N generate-resources in integrations/jvm (or npm run jvm:assets at the repository root), or build the whole reactor, which generates them first</message>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- The Endive runtime and its JFFI runner for PdfRealRuntimeIT, only when asked for (-Ddatum.engine=endive, which
           failsafe also hands the IT as a system property): a module build must not need the engine. Without it the IT
           skips itself with a message. -->
      <id>engine-endive</id>
      <activation>
        <property>
          <name>datum.engine</name>
          <value>endive</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.argusvane</groupId>
          <artifactId>datum-sandbox-endive</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.argusvane</groupId>
          <artifactId>datum-sandbox-endive-jffi</artifactId>
          <type>pom</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
