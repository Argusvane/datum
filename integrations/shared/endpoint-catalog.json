  "schemas": [
    {
      "name": "ErrorItem",
      "description": "One error: the component id it belongs to (left out when none), a stable code, and host-worded text for a person.",
      "properties": [
        {
          "name": "field",
          "type": "string",
          "description": "The component id; the member is left out when the error names none.",
          "nullable": false,
          "example": null
        },
        {
          "name": "code",
          "type": "string",
          "description": "Stable machine code, for example form.outdated.",
          "nullable": false,
          "example": null
        },
        {
          "name": "message",
          "type": "string",
          "description": "Optional text for a person: the form's own wording for a finding or a hook's; never a guest's stderr.",
          "nullable": false,
          "example": null
        }
      ],
      "required": [
        "code"
      ]
    },
    {
      "name": "ErrorsBody",
      "description": "An error answer: {errors:[{field?, code, message?}]}.",
      "properties": [
        {
          "name": "errors",
          "type": "array:ErrorItem",
          "description": null,
          "nullable": false,
          "example": null
        }
      ],
      "required": [
        "errors"
      ]
    },
    {
      "name": "ProblemDetail",
      "description": "RFC 9457 problem details with the same codes (datum.web.api.problem-details=true).",
      "properties": [
        {
          "name": "type",
          "type": "string",
          "description": null,
          "nullable": false,
          "example": "about:blank"
        },
        {
          "name": "title",
          "type": "string",
          "description": null,
          "nullable": false,
          "example": null
        },
        {
          "name": "status",
          "type": "integer",
          "description": null,
          "nullable": false,
          "example": null
        },
        {
          "name": "detail",
          "type": "string",
          "description": null,
          "nullable": false,
          "example": null
        },
        {
          "name": "code",
          "type": "string",
          "description": null,
          "nullable": false,
          "example": null
        },
        {
          "name": "correlationId",
          "type": "string",
          "description": "Names the log entry of a 500.",
          "nullable": false,
          "example": null
        },
        {
          "name": "errors",
          "type": "array:ErrorItem",
          "description": null,
          "nullable": false,
          "example": null
        }
      ],
      "required": []
    },
    {
      "name": "PdfTrustPolicySummary",
      "description": "The trust policy a verify report placed its signers and timestamp authorities under (an addition of this host, which other hosts need not send).",
      "properties": [
        {
          "name": "name",
          "type": "string",
          "description": "The policy's name; default for the configured anchors.",
          "nullable": false,
          "example": "default"
        },
        {
          "name": "revocationChecking",
          "type": "boolean",
          "description": "Whether revocation was checked (the JDK's PKIX revocation checker).",
          "nullable": false,
          "example": null
        },
        {
          "name": "validationTime",
          "type": "string",
          "description": "When chains were judged: now or signing-time.",
          "nullable": false,
          "example": "now"
        }
      ],
      "required": [
        "name",
        "revocationChecking",
        "validationTime"
      ]
    },
    {
      "name": "PdfSignatureVerdict",
      "description": "One signature of a verify report, checked and placed; the members named here, among the others the report carries.",
      "properties": [
        {
          "name": "field",
          "type": "string",
          "description": "The signature field, or empty when no field links it any more.",
          "nullable": false,
          "example": null
        },
        {
          "name": "value",
          "type": "string",
          "description": "valid, invalid or unchecked: the signature value under the signer's key.",
          "nullable": false,
          "example": "valid"
        },
        {
          "name": "digestMatches",
          "type": "boolean",
          "description": "The file still hashes to what was signed.",
          "nullable": false,
          "example": null
        },
        {
          "name": "certificateMatches",
          "type": "boolean",
          "description": "The signed attributes name the signer's certificate.",
          "nullable": false,
          "example": null
        },
        {
          "name": "coversDocument",
          "type": "boolean",
          "description": "Nothing was appended after it.",
          "nullable": false,
          "example": null
        },
        {
          "name": "intact",
          "type": "boolean",
          "description": "Digest, binding and value all hold.",
          "nullable": false,
          "example": null
        },
        {
          "name": "trust",
          "type": "string",
          "description": "site, site_retired, trusted, self_signed or unknown.",
          "nullable": false,
          "example": "site"
        },
        {
          "name": "signingTime",
          "type": "string",
          "description": "The signed revision's /M, ISO 8601: the signer's claim.",
          "nullable": true,
          "example": null
        },
        {
          "name": "trustedAt",
          "type": "string",
          "description": "The instant (ISO 8601) the chain to an anchor was judged at; only for a trusted chain, and optional (an addition of this host, which other hosts need not send).",
          "nullable": true,
          "example": null
        }
      ],
      "required": [
        "field",
        "value",
        "intact",
        "trust"
      ]
    },
    {
      "name": "PdfVerifyReport",
      "description": "A verify report (POST /pdf/verify): the file's hash and size, each signature, the document key, the program's warnings, the embedded files (attachments) and, optionally, the trust policy (an addition of this host, which other hosts need not send).",
      "properties": [
        {
          "name": "sha256",
          "type": "string",
          "description": "The file's SHA-256, lowercase hex.",
          "nullable": false,
          "example": null
        },
        {
          "name": "bytes",
          "type": "integer",
          "description": "The file's size.",
          "nullable": false,
          "example": null
        },
        {
          "name": "signatures",
          "type": "array:PdfSignatureVerdict",
          "description": null,
          "nullable": false,
          "example": null
        },
        {
          "name": "documentId",
          "type": "string",
          "description": "The document key an intact signature signed, else the file's current one.",
          "nullable": true,
          "example": null
        },
        {
          "name": "documentIdSource",
          "type": "string",
          "description": "signed or current.",
          "nullable": true,
          "example": null
        },
        {
          "name": "warnings",
          "type": "array:string",
          "description": "The program's warning messages.",
          "nullable": false,
          "example": null
        },
        {
          "name": "trustPolicy",
          "type": "ref:PdfTrustPolicySummary",
          "description": null,
          "nullable": false,
          "example": null
        }
      ],
      "required": [
        "sha256",
        "bytes",
        "signatures"
      ]
    }
  ],
  "headers": [
    {
      "component": "RetryAfter",
      "header": "Retry-After",
      "description": "Seconds to wait before trying again. On a 503 only server.busy sends it.",
      "type": "integer",
      "minimum": 0
    },
    {
      "component": "ETag",
      "header": "ETag",
      "description": "The sha256 of the definition or catalog the answer carries; send it back as If-Match on a write.",
      "type": "string",
      "minimum": null
    },
    {
      "component": "XDatumRemovedLocales",
      "header": "X-Datum-Removed-Locales",
      "description": "The locales a save removed, comma separated.",
      "type": "string",
      "minimum": null
    },
    {
      "component": "XPageCount",
      "header": "X-Page-Count",
      "description": "The number of pages of the PDF.",
      "type": "integer",
      "minimum": null
    },
    {
      "component": "Location",
      "header": "Location",
      "description": "Where the created form's full definition is read.",
      "type": "string",
      "minimum": null
    }
  ],
  "parameters": [
    {
      "component": "IfMatch",
      "name": "If-Match",
      "description": "The ETag of the version being replaced; a stale one answers 409.",
      "type": "string"
    }
  ],
  "responses": [
    {
      "component": "BadRequest",
      "status": 400,
      "description": "The body is not usable JSON (bad_document).",
      "codes": [
        "bad_document"
      ],
      "retryAfter": false
    },
    {
      "component": "PayloadTooLarge",
      "status": 413,
      "description": "The body is larger than datum.web.api.max-body-size (bad_document).",
      "codes": [
        "bad_document"
      ],
      "retryAfter": false
    },
    {
      "component": "UnsupportedMediaType",
      "status": 415,
      "description": "The Content-Type is not JSON (unsupported_media_type).",
      "codes": [
        "unsupported_media_type"
      ],
      "retryAfter": false
    },
    {
      "component": "Unprocessable",
      "status": 422,
      "description": "Rejected: the errors name the codes and fields.",
      "codes": [],
      "retryAfter": false
    },
    {
      "component": "TooManyRequests",
      "status": 429,
      "description": "Throttled (flood); wait Retry-After seconds.",
      "codes": [
        "flood"
      ],
      "retryAfter": true
    },
    {
      "component": "Unavailable",
      "status": 503,
      "description": "The sandbox is busy or unavailable (server.busy with Retry-After, server.unavailable without); try again.",
      "codes": [
        "server.busy",
        "server.unavailable"
      ],
      "retryAfter": true,
      "retryAfterCodes": [
        "server.busy"
      ]
    },
    {
      "component": "InternalError",
      "status": 500,
      "description": "An unexpected failure (internal); the correlation id is in the log.",
      "codes": [
        "internal"
      ],
      "retryAfter": false
    }
  ],
  "defaultResponses": [
    {
      "status": 400,
      "component": "BadRequest",
      "when": "body"
    },
    {
      "status": 413,
      "component": "PayloadTooLarge",
      "when": "body"
    },
    {
      "status": 415,
      "component": "UnsupportedMediaType",
      "when": "body"
    },
    {
      "status": 422,
      "component": "Unprocessable",
      "when": "body"
    },
    {
      "status": 429,
      "component": "TooManyRequests",
      "when": "post"
    },
    {
      "status": 500,
      "component": "InternalError",
      "when": "always"
    },
    {
      "status": 503,
      "component": "Unavailable",
      "when": "always"
    }
  ]
}
