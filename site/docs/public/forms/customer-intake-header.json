{
  "id": "customer-intake-header",
  "version": "1.0.0",
  "schemaVersion": "1",
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": [
      {
        "code": "en",
        "label": "English"
      },
      {
        "code": "fr-CA",
        "label": "Français"
      }
    ]
  },
  "root": {
    "id": "root",
    "type": "form",
    "configuration": {
      "title": "Customer Intake",
      "messages": {
        "maxLength": "Keep it under {maxLength} characters."
      },
      "chrome": {
        "frame": "outlined",
        "header": [
          {
            "id": "brand",
            "type": "group",
            "parts": [
              {
                "id": "logo",
                "type": "image",
                "src": "data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22132%22%20height%3D%2232%22%20viewBox%3D%220%200%20132%2032%22%3E%3Crect%20width%3D%2232%22%20height%3D%2232%22%20rx%3D%228%22%20fill%3D%22%2326374a%22%2F%3E%3Cpath%20d%3D%22M9%2022%2016%209l7%2013H9z%22%20fill%3D%22%23fff%22%2F%3E%3Ctext%20x%3D%2240%22%20y%3D%2221%22%20font-family%3D%22system-ui%2C%20sans-serif%22%20font-size%3D%2215%22%20font-weight%3D%22600%22%20fill%3D%22%2326374a%22%3EAcme%20Forms%3C%2Ftext%3E%3C%2Fsvg%3E",
                "alt": "Acme Forms",
                "height": 32
              },
              {
                "id": "switcher",
                "type": "language-switcher"
              }
            ]
          },
          {
            "id": "title",
            "type": "form-title"
          },
          {
            "id": "intro",
            "type": "text",
            "text": "Takes about five minutes. Fields marked required must be filled in."
          }
        ],
        "footer": [
          {
            "id": "contact",
            "type": "text",
            "align": "center",
            "text": "Questions? Write to forms@acme.example."
          }
        ]
      }
    },
    "children": {
      "content": [
        {
          "id": "fullName",
          "type": "text",
          "configuration": {
            "label": "Full name",
            "description": "As it appears on a government ID",
            "required": true,
            "messages": {
              "required": "Enter your full name."
            }
          }
        },
        {
          "id": "country",
          "type": "select",
          "configuration": {
            "label": "Country",
            "data": {
              "sourceId": "countries"
            }
          }
        },
        {
          "id": "contactMethod",
          "type": "radio",
          "configuration": {
            "label": "Preferred contact method",
            "options": [
              {
                "value": "email",
                "label": "Email"
              },
              {
                "value": "phone",
                "label": "Phone"
              }
            ]
          }
        },
        {
          "id": "newsletter",
          "type": "fieldset",
          "configuration": {
            "label": "Newsletter"
          },
          "children": {
            "content": [
              {
                "id": "subscribe",
                "type": "checkbox",
                "configuration": {
                  "label": "Subscribe to the newsletter"
                }
              },
              {
                "id": "newsletterEmail",
                "type": "text",
                "configuration": {
                  "label": "Newsletter email",
                  "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+",
                  "patternMessage": "Enter an email address."
                },
                "rules": {
                  "visibleWhen": "subscribe"
                }
              }
            ]
          }
        },
        {
          "id": "notes",
          "type": "textarea",
          "configuration": {
            "label": "Additional notes",
            "maxLength": 500
          }
        },
        {
          "id": "submit",
          "type": "button",
          "configuration": {
            "label": "Submit",
            "action": "submit"
          }
        }
      ]
    }
  },
  "translations": {
    "fr-CA": {
      "form": {
        "messages": {
          "maxLength": {
            "text": "Au plus {maxLength} caractères.",
            "source": "7cdk7t"
          }
        }
      },
      "components": {
        "fullName": {
          "label": {
            "text": "Nom complet",
            "source": "13z0t9r"
          },
          "description": {
            "text": "Tel qu'il apparaît sur une pièce d'identité",
            "source": "1u3kqke"
          },
          "messages": {
            "required": {
              "text": "Entrez votre nom complet.",
              "source": "8bi3le"
            }
          }
        },
        "country": {
          "label": {
            "text": "Pays",
            "source": "1diicx"
          }
        },
        "contactMethod": {
          "label": {
            "text": "Mode de contact préféré",
            "source": "1asuvwb"
          },
          "options": {
            "email": {
              "label": {
                "text": "Courriel",
                "source": "inbfc7"
              }
            },
            "phone": {
              "label": {
                "text": "Téléphone",
                "source": "kb2lhr"
              }
            }
          }
        },
        "newsletter": {
          "label": {
            "text": "Infolettre",
            "source": "oapagq"
          }
        },
        "subscribe": {
          "label": {
            "text": "S'abonner à l'infolettre",
            "source": "1l7gaq6"
          }
        },
        "newsletterEmail": {
          "label": {
            "text": "Courriel de l'infolettre",
            "source": "fwj2oq"
          }
        },
        "notes": {
          "label": {
            "text": "Notes supplémentaires",
            "source": "126tvmx"
          }
        },
        "submit": {
          "label": {
            "text": "Envoyer",
            "source": "hvztxh"
          }
        }
      },
      "texts": {
        "form": {
          "noticeSuccess": {
            "text": "Succès : ",
            "source": "1gkv322"
          }
        }
      },
      "chrome": {
        "logo": {
          "alt": {
            "text": "Formulaires Acme",
            "source": "1gbiow4"
          }
        },
        "intro": {
          "text": {
            "text": "Environ cinq minutes. Les champs obligatoires doivent être remplis.",
            "source": "3av45m"
          }
        },
        "contact": {
          "text": {
            "text": "Des questions? Écrivez à forms@acme.example.",
            "source": "bt8u0e"
          }
        }
      }
    }
  }
}