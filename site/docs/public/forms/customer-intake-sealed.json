{
  "id": "customer-intake",
  "version": "1.0.0",
  "schemaVersion": "1",
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": [
      {
        "code": "en",
        "label": "English"
      },
      {
        "code": "fr-CA",
        "label": "Français"
      }
    ]
  },
  "root": {
    "id": "root",
    "type": "form",
    "configuration": {
      "title": "Customer Intake",
      "messages": {
        "maxLength": "Keep it under {maxLength} characters."
      }
    },
    "children": {
      "content": [
        {
          "id": "fullName",
          "type": "text",
          "configuration": {
            "label": "Full name",
            "description": "As it appears on a government ID",
            "required": true,
            "messages": {
              "required": "Enter your full name."
            }
          }
        },
        {
          "id": "country",
          "type": "select",
          "configuration": {
            "label": "Country",
            "data": {
              "sourceId": "countries"
            }
          }
        },
        {
          "id": "contactMethod",
          "type": "radio",
          "configuration": {
            "label": "Preferred contact method",
            "options": [
              {
                "value": "email",
                "label": "Email"
              },
              {
                "value": "phone",
                "label": "Phone"
              }
            ]
          }
        },
        {
          "id": "newsletter",
          "type": "fieldset",
          "configuration": {
            "label": "Newsletter"
          },
          "children": {
            "content": [
              {
                "id": "subscribe",
                "type": "checkbox",
                "configuration": {
                  "label": "Subscribe to the newsletter"
                }
              },
              {
                "id": "newsletterEmail",
                "type": "text",
                "configuration": {
                  "label": "Newsletter email",
                  "pattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+",
                  "patternMessage": "Enter an email address."
                },
                "rules": {
                  "visibleWhen": "subscribe"
                }
              }
            ]
          }
        },
        {
          "id": "notes",
          "type": "textarea",
          "configuration": {
            "label": "Additional notes",
            "maxLength": 500
          }
        },
        {
          "id": "submit",
          "type": "button",
          "configuration": {
            "label": "Submit",
            "action": "submit"
          }
        }
      ]
    }
  },
  "translations": {
    "fr-CA": {
      "form": {
        "messages": {
          "maxLength": {
            "text": "Au plus {maxLength} caractères.",
            "source": "7cdk7t"
          }
        }
      },
      "components": {
        "fullName": {
          "label": {
            "text": "Nom complet",
            "source": "13z0t9r"
          },
          "description": {
            "text": "Tel qu'il apparaît sur une pièce d'identité",
            "source": "1u3kqke"
          },
          "messages": {
            "required": {
              "text": "Entrez votre nom complet.",
              "source": "8bi3le"
            }
          }
        },
        "country": {
          "label": {
            "text": "Pays",
            "source": "1diicx"
          }
        },
        "contactMethod": {
          "label": {
            "text": "Mode de contact préféré",
            "source": "1asuvwb"
          },
          "options": {
            "email": {
              "label": {
                "text": "Courriel",
                "source": "inbfc7"
              }
            },
            "phone": {
              "label": {
                "text": "Téléphone",
                "source": "kb2lhr"
              }
            }
          }
        },
        "newsletter": {
          "label": {
            "text": "Infolettre",
            "source": "oapagq"
          }
        },
        "subscribe": {
          "label": {
            "text": "S'abonner à l'infolettre",
            "source": "1l7gaq6"
          }
        },
        "newsletterEmail": {
          "label": {
            "text": "Courriel de l'infolettre",
            "source": "fwj2oq"
          }
        },
        "notes": {
          "label": {
            "text": "Notes supplémentaires",
            "source": "126tvmx"
          }
        },
        "submit": {
          "label": {
            "text": "Envoyer",
            "source": "hvztxh"
          }
        }
      },
      "texts": {
        "form": {
          "noticeSuccess": {
            "text": "Succès : ",
            "source": "1gkv322"
          }
        }
      },
      "pdf": {
        "sealed-record": {
          "name": {
            "text": "Dossier scellé",
            "source": "tvojgi"
          },
          "signature": {
            "reason": {
              "text": "Reçu et validé par le service d'admission",
              "source": "9a3sw4"
            }
          },
          "nodes": {
            "seal": {
              "label": {
                "text": "Scellé par le service d'admission",
                "source": "30olbk"
              }
            }
          }
        }
      }
    }
  },
  "pdf": {
    "layouts": [
      {
        "id": "sealed-record",
        "kind": "generated",
        "name": "Sealed record",
        "page": {
          "footer": {
            "height": 24
          }
        },
        "root": {
          "id": "document",
          "type": "pdf-document",
          "configuration": {},
          "children": {
            "body": [
              {
                "id": "title",
                "type": "pdf-text",
                "configuration": {
                  "text": "Customer intake",
                  "variant": "h1"
                }
              },
              {
                "id": "pdf-fullName",
                "type": "pdf-field",
                "configuration": {
                  "componentId": "fullName"
                }
              },
              {
                "id": "pdf-country",
                "type": "pdf-field",
                "configuration": {
                  "componentId": "country"
                }
              },
              {
                "id": "pdf-contactMethod",
                "type": "pdf-field",
                "configuration": {
                  "componentId": "contactMethod"
                }
              },
              {
                "id": "sec-newsletter",
                "type": "pdf-section",
                "configuration": {
                  "label": "Newsletter",
                  "skipWhenEmpty": true
                },
                "children": {
                  "content": [
                    {
                      "id": "pdf-subscribe",
                      "type": "pdf-field",
                      "configuration": {
                        "componentId": "subscribe"
                      }
                    },
                    {
                      "id": "pdf-newsletterEmail",
                      "type": "pdf-field",
                      "configuration": {
                        "componentId": "newsletterEmail"
                      }
                    }
                  ]
                }
              },
              {
                "id": "pdf-notes",
                "type": "pdf-field",
                "configuration": {
                  "componentId": "notes"
                }
              },
              {
                "id": "seal-space",
                "type": "pdf-spacer",
                "configuration": {
                  "height": 18
                }
              },
              {
                "id": "seal",
                "type": "pdf-signature",
                "configuration": {
                  "fieldName": "server-signature",
                  "label": "Sealed by the intake service",
                  "width": 220,
                  "height": 56
                }
              }
            ],
            "header": [],
            "footer": [
              {
                "id": "footer",
                "type": "pdf-table",
                "configuration": {
                  "rows": 1,
                  "columns": 2,
                  "header": false,
                  "borders": "none",
                  "style": {
                    "spacingBefore": 0,
                    "spacingAfter": 0
                  }
                },
                "children": {
                  "r1c1": [
                    {
                      "id": "footer-title",
                      "type": "pdf-text",
                      "configuration": {
                        "text": "Customer intake",
                        "variant": "muted",
                        "style": {
                          "spacingBefore": 0,
                          "spacingAfter": 0
                        }
                      }
                    }
                  ],
                  "r1c2": [
                    {
                      "id": "footer-pages",
                      "type": "pdf-text",
                      "configuration": {
                        "text": "Page {{page}} of {{pages}}",
                        "variant": "muted",
                        "align": "end",
                        "style": {
                          "spacingBefore": 0,
                          "spacingAfter": 0
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        "signature": {
          "field": "server-signature",
          "certify": "noChanges",
          "reason": "Received and validated by the intake service",
          "location": "Ottawa"
        }
      }
    ],
    "defaultLayoutId": "sealed-record"
  }
}
