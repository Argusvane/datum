# Build output, personal tooling and local secrets: kept on disk, never tracked
engine/vitest*.json
*.tsbuildinfo
tasks.md
CLAUDE.md
.claude/
.rtk/
.env
.env.*

node_modules/
dist/
dist-test/
coverage/
.DS_Store
*.log
.npm-cache/

# The demo assets the site serves: copied from packages/datum/dist and plugins/*/dist by site/scripts/copy-demo-assets.mjs, so generated and never tracked
site/public/demo/

# Generated by the release-gate scripts
engine/gate-inputs.json
engine/gate-report.json

# Python (tools/piv-agent, integrations/fastapi)
__pycache__/
.venv/

# Screenshots the visual-regression driver writes; the signatures beside them are committed
packages/datum/visual/out/

# Build locks shared by sessions in this checkout (scripts/with-lock.mjs)
.locks/

# Datum for the JVM (integrations/jvm: libraries, Spring Boot bindings, host test kit): build output. The generated assets are
# build output too: the Maven build writes them, with the test fixtures, to integrations/jvm/target/datum-assets (covered by target/
# below), so nothing generated sits beside a module's sources any more.
integrations/jvm/**/target/
integrations/jvm/dist/
integrations/jvm/.mvn/wrapper/*.jar
integrations/jvm/**/.flattened-pom.xml
# Development signing keys (integrations/jvm examples): a private key is never committed
integrations/jvm/**/local/
integrations/jvm/**/*.p12

# Datum for FastAPI (integrations/fastapi): build output and the generated files of each distribution
# (integrations/fastapi/scripts/build-assets.mjs). runtime.json is the committed pin and is NOT ignored.
integrations/fastapi/build/
integrations/fastapi/dist/
integrations/fastapi/packages/*/src/datum_programs/resources/
integrations/fastapi/packages/*/src/datum_assets_ui/assets/
integrations/fastapi/packages/*/src/datum_assets_pdf/assets/
integrations/fastapi/packages/*/src/datum_qjs_wasm/*.wasm
integrations/fastapi/packages/*/src/datum_fastapi/web/resources/
integrations/fastapi/packages/*/src/*/datum-build.json
integrations/fastapi/packages/*/src/*/manifest.json
integrations/fastapi/packages/*/src/*/datum-settings.schema.json
integrations/fastapi/packages/*/NOTICE
integrations/fastapi/.venv/
integrations/fastapi/**/__pycache__/
integrations/fastapi/**/.mypy_cache/
integrations/fastapi/**/.ruff_cache/
integrations/fastapi/**/.pytest_cache/
integrations/fastapi/**/.coverage*

# VitePress build cache of the docs site (site/docs); its output goes to site/dist/docs
site/docs/.vitepress/cache/

# .NET build output of the documentation snippets, and vitest's JSON reporter output
site/docs/snippets/**/obj/
site/docs/snippets/**/bin/
**/.vitest/

# Timings merged by engine/scripts/bench-feel.mjs: machine-specific, rewritten on every run
engine/scripts/bench-feel.last.json
