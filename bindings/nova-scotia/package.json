{
  "name": "@argusvane/datum-binding-nova-scotia",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Argusvane <maintainers@argusvane.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argusvane/datum.git",
    "directory": "bindings/nova-scotia"
  },
  "homepage": "https://datum.argusvane.com",
  "bugs": {
    "url": "https://github.com/argusvane/datum/issues"
  },
  "keywords": [
    "datum",
    "forms",
    "form-renderer",
    "design-system",
    "binding"
  ],
  "description": "Nova Scotia UI Pattern Library (Bootstrap 3, saltire.css) (nsgov.github.io/patternlibrary) binding for the Datum form renderer: Datum's components drawn in the design system's own markup.",
  "type": "module",
  "datumBinding": {
    "id": "nova-scotia",
    "designSystem": "Nova Scotia UI Pattern Library (Bootstrap 3, saltire.css)",
    "release": "663c256",
    "bundle": "dist/nova-scotia.js",
    "global": "DatumBindingNovaScotia",
    "budgetKb": 10.5,
    "checks": [
      "tests/checks.mjs",
      "tests/hooks.mjs",
      "tests/references.mjs"
    ]
  },
  "scripts": {
    "build": "node ../../packages/datum/binding-kit/build.mjs --binding nova-scotia",
    "typecheck": "tsc --noEmit",
    "reference": "node ./reference/generate.mjs",
    "test": "npm run build && node ./tests/checks.mjs && node ./tests/hooks.mjs && node ./reference/generate.mjs --check",
    "kit:check": "node ../../packages/datum/binding-kit/check.mjs --binding nova-scotia",
    "kit:build": "node ../../packages/datum/binding-kit/build.mjs --binding nova-scotia",
    "kit:equality": "node ../../packages/datum/binding-kit/equality.mjs --binding nova-scotia",
    "kit:behaviour": "node ../../packages/datum/binding-kit/behaviour.mjs --binding nova-scotia",
    "kit:conformance": "node ../../packages/datum/binding-kit/conformance.ts --binding nova-scotia",
    "kit:serve": "node ../../packages/datum/binding-kit/serve.mjs --binding nova-scotia"
  },
  "devDependencies": {
    "@argusvane/datum-engine": "file:../../engine",
    "esbuild": "^0.28.2",
    "font-awesome-4.7.0": "npm:font-awesome@4.7.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  }
}
