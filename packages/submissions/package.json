{
  "name": "@argusvane/datum-submissions",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Argusvane <maintainers@argusvane.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argusvane/datum.git",
    "directory": "packages/submissions"
  },
  "homepage": "https://datum.argusvane.com",
  "bugs": {
    "url": "https://github.com/argusvane/datum/issues"
  },
  "keywords": [
    "datum",
    "forms",
    "submissions",
    "pdf",
    "server"
  ],
  "description": "A submissions server for Datum forms as a platform-neutral service: a catalog of form definitions, an endpoint that validates and keeps what a form sends, server-rendered and signed PDFs, statistics, signature inspection, and the way back from a PDF to its record. Storage, validation, PDF rendering and keys are seams a host binds.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@argusvane/datum-engine": "file:../../engine",
    "@argusvane/datum-pdf-kernel": "file:../pdf-kernel",
    "@argusvane/datum-quickjs-wasm-host": "file:../quickjs-wasm-host"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
