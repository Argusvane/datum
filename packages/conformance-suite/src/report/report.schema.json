{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://datum.example/schemas/security-suite-report-1.json",
  "title": "Datum security suite report",
  "type": "object",
  "required": ["schemaVersion", "suite", "run", "environment", "summary", "verdict", "reasons", "results"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": {
      "type": "object",
      "required": ["name", "version", "vectorSet", "vectorCount"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "vectorSet": { "type": "string" },
        "vectorCount": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "startedAt", "finishedAt", "durationMs", "modes", "gate", "argv"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "modes": { "type": "array", "items": { "enum": ["program", "endpoint", "parity", "builder", "pdf"] }, "minItems": 1 },
        "gate": { "enum": ["release", "full"] },
        "argv": { "type": "array", "items": { "type": "string" } }
      }
    },
    "environment": {
      "type": "object",
      "required": ["node", "platform", "arch", "ci", "engine", "quickjs"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "ci": { "type": "boolean" },
        "engine": {
          "type": "object",
          "required": ["abi", "commit"],
          "additionalProperties": false,
          "properties": { "abi": { "type": "string" }, "commit": { "type": ["string", "null"] } }
        },
        "quickjs": {
          "type": "object",
          "required": ["package", "variant"],
          "additionalProperties": false,
          "properties": { "package": { "type": "string" }, "variant": { "type": "string" } }
        }
      }
    },
    "program": {
      "type": "object",
      "required": ["source", "path", "bytes", "sha256", "bannerAbi", "detectedAbi", "abiFloor", "abiOk", "manifestAbi", "budgetProfile", "golden", "startupError"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["file", "built"] },
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bannerAbi": { "type": ["string", "null"] },
        "detectedAbi": { "type": ["string", "null"] },
        "abiFloor": { "type": "string" },
        "abiOk": { "type": "boolean" },
        "manifestAbi": { "type": ["string", "null"] },
        "budgetProfile": { "enum": ["node", "browser"] },
        "golden": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["file", "abi"],
              "additionalProperties": false,
              "properties": { "file": { "type": "string" }, "abi": { "type": "string" }, "note": { "type": "string" } }
            }
          ]
        },
        "startupError": { "type": ["string", "null"] }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["baseUrl", "profile", "formId", "formVersion", "authHeaderName", "fixtureVersion", "preflight", "writes", "requestsSent", "rateLimited", "recordsCreated"],
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string" },
        "profile": { "type": "string" },
        "formId": { "type": "string" },
        "formVersion": { "type": "string" },
        "authHeaderName": { "type": ["string", "null"] },
        "fixtureVersion": { "type": ["string", "null"] },
        "preflight": {
          "type": "object",
          "required": ["ok", "evidence"],
          "additionalProperties": false,
          "properties": { "ok": { "type": "boolean" }, "evidence": { "type": "array", "items": { "type": "string" } } }
        },
        "writes": { "type": "boolean" },
        "requestsSent": { "type": "integer", "minimum": 0 },
        "rateLimited": { "type": "boolean" },
        "recordsCreated": { "type": "integer", "minimum": 0 }
      }
    },
    "builder": {
      "type": "object",
      "required": ["baseUrl", "host", "formId", "mode", "authHeaderName", "requestsSent", "saves", "requestsByTemplate", "cleanup", "recordsCreated"],
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string" },
        "host": { "enum": ["submissions"] },
        "formId": { "type": "string" },
        "mode": { "enum": ["create", "adopt"] },
        "authHeaderName": { "type": ["string", "null"] },
        "requestsSent": { "type": "integer", "minimum": 0 },
        "saves": { "type": "integer", "minimum": 0 },
        "requestsByTemplate": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "cleanup": {
          "type": "object",
          "required": ["complete"],
          "additionalProperties": false,
          "properties": { "complete": { "type": "boolean" }, "formId": { "type": "string" }, "remedy": { "type": "string" }, "detail": { "type": "string" } }
        },
        "recordsCreated": { "type": "integer", "minimum": 0 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pdf": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "abi", "pending", "tools"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "abi": { "type": ["string", "null"] },
        "pending": { "type": ["string", "null"] },
        "tools": {
          "type": "object",
          "required": ["fonts", "pdfjs", "pdfLib", "verapdf", "openssl"],
          "additionalProperties": false,
          "properties": { "fonts": { "type": "string" }, "pdfjs": { "type": "boolean" }, "pdfLib": { "type": "boolean" }, "verapdf": { "type": "boolean" }, "openssl": { "type": "boolean" } }
        }
      }
    },
    "parity": {
      "type": "object",
      "required": ["adapters", "corpus", "divergences"],
      "additionalProperties": false,
      "properties": {
        "adapters": { "type": "array", "items": { "type": "string" } },
        "corpus": {
          "type": "object",
          "required": ["core", "adversarial", "suite"],
          "additionalProperties": false,
          "properties": { "core": { "type": "integer" }, "adversarial": { "type": "integer" }, "suite": { "type": "integer" } }
        },
        "divergences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vector", "reason", "stale"],
            "additionalProperties": false,
            "properties": { "vector": { "type": "string" }, "reason": { "type": "string" }, "stale": { "type": "boolean" } }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "warn", "skip", "xfail", "xpass", "error"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 },
        "xfail": { "type": "integer", "minimum": 0 },
        "xpass": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      }
    },
    "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "results": { "type": "array", "items": { "$ref": "#/definitions/result" } }
  },
  "definitions": {
    "status": { "enum": ["PASS", "FAIL", "WARN", "SKIP", "XFAIL", "XPASS", "ERROR"] },
    "observation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "accepted", "errors"],
          "properties": {
            "kind": { "const": "verdict" },
            "accepted": { "type": "boolean" },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "type": "string" }, "field": { "type": ["string", "null"] }, "severity": { "type": "string" } }
              }
            },
            "values": {},
            "logs": { "type": "array", "items": { "type": "object", "required": ["level", "message"], "properties": { "level": { "type": "string" }, "message": { "type": "string" } } } },
            "digest": { "type": "string" },
            "canonical": { "type": "string" },
            "raw": {}
          }
        },
        {
          "type": "object",
          "required": ["kind", "refusal", "detail"],
          "properties": {
            "kind": { "const": "refusal" },
            "refusal": {
              "enum": ["too_large", "too_deep", "budget", "bad_document", "outdated", "unavailable", "rate_limited", "not_found", "method", "definition_too_deep", "server_error", "malformed_response", "definition_refused", "forbidden", "unsupported_media", "other"]
            },
            "code": { "type": "string" },
            "codes": { "type": "array", "items": { "type": "string" } },
            "http": { "type": "integer" },
            "detail": { "type": "string" }
          }
        },
        { "type": "object", "required": ["kind", "json"], "properties": { "kind": { "const": "answer" }, "json": {} } }
      ]
    },
    "exchange": {
      "type": "object",
      "required": ["requests", "connectMs", "firstByteMs", "totalMs"],
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "connectMs": { "type": "number", "minimum": 0 },
        "firstByteMs": { "type": "number", "minimum": 0 },
        "totalMs": { "type": "number", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "required": ["id", "title", "class", "severity", "attacker", "runner", "status", "gate", "blockedBy", "expected", "observed", "durationMs", "limitMs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2,3}$" },
        "title": { "type": "string" },
        "class": { "enum": ["control", "abi", "isolation", "resource", "options", "files", "context", "canonical", "receiver", "secrecy", "parity", "definition", "builder", "output", "journey", "test"] },
        "severity": { "enum": ["S1", "S2", "S3", "S4"] },
        "attacker": { "enum": ["filler", "author", "plugin-author", "source-operator", "network", "host-config"] },
        "runner": { "enum": ["program", "endpoint", "parity", "builder", "pdf"] },
        "status": { "$ref": "#/definitions/status" },
        "gate": { "enum": ["enforced", "advisory", "pending"] },
        "blockedBy": { "type": ["string", "null"] },
        "expected": { "type": "string" },
        "observed": { "$ref": "#/definitions/observation" },
        "durationMs": { "type": "number", "minimum": 0 },
        "limitMs": { "type": ["number", "null"] },
        "exchange": { "$ref": "#/definitions/exchange" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "expected", "observed"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "status": { "$ref": "#/definitions/status" },
              "expected": { "type": "string" },
              "observed": { "$ref": "#/definitions/observation" },
              "exchange": { "$ref": "#/definitions/exchange" },
              "notes": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requestSha256": { "type": "string" }, "requestBytes": { "type": "integer" }, "responseExcerpt": { "type": "string" } }
        },
        "notes": { "type": "string" },
        "hostSensitive": { "type": "boolean" }
      }
    }
  }
}
