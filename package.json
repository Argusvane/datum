{
  "name": "datum",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Argusvane <maintainers@argusvane.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argusvane/datum.git"
  },
  "homepage": "https://datum.argusvane.com",
  "bugs": {
    "url": "https://github.com/argusvane/datum/issues"
  },
  "keywords": [
    "datum",
    "forms",
    "form-builder",
    "validation"
  ],
  "description": "Datum multi-project workspace shell.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "engine:build": "npm --prefix ./engine run build",
    "engine:typecheck": "npm --prefix ./engine run typecheck",
    "engine:test": "npm --prefix ./engine run test",
    "engine:lint:arch": "npm --prefix ./engine run lint:arch",
    "engine:ci": "npm --prefix ./engine run ci",
    "site:setup": "node scripts/setup.mjs engine bindings site",
    "site:dev": "npm --prefix ./site run dev",
    "site:build": "npm --prefix ./site run build",
    "site:preview": "npm --prefix ./site run preview",
    "site:demo-assets": "node scripts/with-lock.mjs datum-dist -- npm --prefix ./site run demo-assets",
    "site:typecheck": "npm --prefix ./site run typecheck",
    "site:test": "npm --prefix ./site run test",
    "bindings:build": "for d in bindings/*/; do npm --prefix \"$d\" run build || exit 1; done",
    "plugins:build": "for d in plugins/*/; do npm --prefix \"$d\" run build || exit 1; done",
    "plugins:typecheck": "for d in plugins/*/; do npm --prefix \"$d\" run typecheck || exit 1; done",
    "plugins:test": "for d in plugins/*/; do npm --prefix \"$d\" run test || exit 1; done",
    "quickjs-host:build": "npm --prefix ./packages/quickjs-wasm-host run build",
    "quickjs-host:typecheck": "npm --prefix ./packages/quickjs-wasm-host run typecheck",
    "quickjs-host:test": "npm --prefix ./packages/quickjs-wasm-host run test",
    "pdf-kernel:build": "npm --prefix ./packages/pdf-kernel run build",
    "pdf-kernel:typecheck": "npm --prefix ./packages/pdf-kernel run typecheck",
    "pdf-kernel:test": "npm --prefix ./packages/pdf-kernel run test",
    "submissions:build": "npm --prefix ./packages/submissions run build",
    "submissions:typecheck": "npm --prefix ./packages/submissions run typecheck",
    "submissions:test": "npm --prefix ./packages/submissions run test",
    "conformance-suite:build": "npm --prefix ./packages/conformance-suite run build",
    "conformance-suite:typecheck": "npm --prefix ./packages/conformance-suite run typecheck",
    "conformance-suite:test": "npm --prefix ./packages/conformance-suite run test",
    "form-test:typecheck": "npm --prefix ./packages/form-test run typecheck",
    "form-test:test": "npm --prefix ./packages/form-test run test",
    "conformance-suite:check": "npm --prefix ./packages/conformance-suite run check:source --",
    "conformance-suite:host-check": "node ./packages/conformance-suite/bin/datum-host-check.mjs",
    "datum:build": "npm --prefix ./packages/datum run build",
    "datum:typecheck": "npm --prefix ./packages/datum run typecheck",
    "datum:test": "npm --prefix ./packages/datum run test",
    "datum:demo": "npm --prefix ./packages/datum run demo",
    "datum:a11y": "npm --prefix ./packages/datum run a11y",
    "datum:a11y:browser": "npm --prefix ./packages/datum run a11y:browser",
    "ci": "npm run setup && npm run engine:ci && npm run plugins:typecheck && npm run plugins:test && npm run quickjs-host:test && npm run pdf-kernel:typecheck && npm run pdf-kernel:test && npm run submissions:typecheck && npm run submissions:test && npm run conformance-suite:typecheck && npm run conformance-suite:test && npm run form-test:typecheck && npm run form-test:test && npm run datum:typecheck && npm run datum:test && npm run datum:build && npm run plugins:build && npm run bindings:build && npm run site:demo-assets && npm run site:build && npm run site:test",
    "shared:canonical-fixtures": "packages/datum/node_modules/.bin/vite-node --root packages/datum integrations/shared/scripts/canonical-fixtures.ts",
    "shared:check-neutral": "node integrations/shared/scripts/check-neutral.mjs",
    "jvm:test": "./integrations/jvm/mvnw -q -B -f integrations/jvm/pom.xml verify",
    "jvm:test:scripts": "node --test integrations/jvm/scripts/tests/*.test.mjs",
    "jvm:assets": "node scripts/with-lock.mjs datum-dist -- node integrations/jvm/scripts/build-assets.mjs --out integrations/jvm/target/datum-assets",
    "jvm:release": "node integrations/jvm/scripts/release.mjs",
    "jvm:pin-runtime": "node integrations/shared/scripts/pin-runtime.mjs --target jvm",
    "fastapi:prepare": "node integrations/fastapi/scripts/prepare.mjs",
    "fastapi:assets": "node scripts/with-lock.mjs datum-dist -- node integrations/fastapi/scripts/build-assets.mjs",
    "fastapi:pin-runtime": "node integrations/shared/scripts/pin-runtime.mjs --target fastapi",
    "fastapi:host-run": "node integrations/fastapi/scripts/host-run.mjs",
    "fastapi:test:scripts": "node --test integrations/fastapi/scripts/tests/*.test.mjs",
    "fastapi:test": "npm run fastapi:test:scripts && cd integrations/fastapi && uv sync --all-packages --all-extras ${DATUM_UV_NO_EXTRAS:-} --frozen && node scripts/test-members.mjs",
    "fastapi:release": "node integrations/fastapi/scripts/release.mjs",
    "offline:packs": "node scripts/offline/binding-packs.mjs",
    "offline:check": "node scripts/offline/check.mjs",
    "offline:bundle": "node scripts/offline/bundle.mjs",
    "offline:test": "node --test scripts/offline/tests/*.test.mjs",
    "site:docs-dev": "npm --prefix ./site run docs:dev",
    "site:docs-build": "npm --prefix ./site run docs:build"
  }
}
